# Great Falls Heating and Air - Environment Configuration

# Email Dispatch Configuration (Resend or equivalent provider)
CONTACT_TO_EMAIL=dispatch@greatfallsheatingandair.com
CONTACT_FROM_EMAIL=notifications@greatfallsheatingandair.com
EMAIL_PROVIDER_API_KEY=
LEAD_EMAIL_MODE=simulate

# Production submissions deliberately return 503 until the development-only
# src/lib/validation/rateLimit.ts is replaced by a durable shared limiter.

# Public Canonical Site URL (Used for SEO, canonical tags, and OpenGraph images)
NEXT_PUBLIC_SITE_URL=https://greatfallsheatingandair.com
